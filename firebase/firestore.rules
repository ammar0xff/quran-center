rules_version = '2';

// Authorization model
// -------------------
// * users/{uid} is the authoritative account record. It is written ONLY by
//   trusted backend code (Admin SDK / Cloud Functions), never by clients, so a
//   user cannot grant themselves a role or re-activate themselves.
// * Role and status are read from users/{uid} (not from client data), so a
//   suspension takes effect immediately even if an ID token is still valid.
// * Teacher document ids equal the teacher's auth uid (set at provisioning).
// * Anything not matched below is denied (default deny).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Active member of [centerId].
    function isActiveMember(centerId) {
      return hasProfile()
        && profile().status == 'active'
        && profile().centerId == centerId;
    }

    function hasRole(centerId, role) {
      return isActiveMember(centerId) && profile().role == role;
    }

    function isDirector(centerId) { return hasRole(centerId, 'director'); }
    function isTeacher(centerId)  { return hasRole(centerId, 'teacher'); }

    // The student profile this (student-role) account is linked to.
    function ownsStudent(centerId, studentId) {
      return hasRole(centerId, 'student') && profile().studentId == studentId;
    }

    // Keys that changed between the stored doc and the incoming write.
    function changed(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function unchanged(keys) {
      return !changed(keys);
    }

    // The session's teacher moves it scheduled -> inProgress (not before its
    // date) or inProgress -> completed. Nothing else on the session changes.
    function teacherMaySetSessionStatus() {
      return isTeacher(resource.data.centerId)
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'startedAt', 'completedAt'])
        && ((resource.data.status == 'scheduled'
             && request.resource.data.status == 'inProgress'
             && resource.data.date <= request.time)
            || (resource.data.status == 'inProgress'
             && request.resource.data.status == 'completed'));
    }

    // While the session is still in progress, the teacher who recorded a
    // value may fix their own entry. Once it is completed, only a director's
    // audited correction can change it.
    function teacherMayFixOwnRecord() {
      return isTeacher(resource.data.centerId)
        && resource.data.recordedBy == request.auth.uid
        && sessionDoc(resource.data.sessionId).status == 'inProgress'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'note', 'updatedAt'])
        && request.resource.data.status in ['present', 'absent', 'late', 'excused'];
    }

    // The teacher may work with this student in this session: the student is
    // one of their own, or was added to the session as a visiting student.
    function mayTeachStudent(sessionId, studentId, centerId) {
      return (request.auth.uid in studentOf(studentId).assignedTeacherIds
              && studentOf(studentId).centerId == centerId)
        || studentId in sessionDoc(sessionId).get('guestStudentIds', []);
    }

    function validGrade(d) {
      return d.get('grade', '') in ['excellent', 'veryGood', 'good', 'acceptable', 'repeat'];
    }

    // The session's teacher adds ONE visiting student (a student of the same
    // center, taken from the directory) while the session is in progress.
    function teacherMayAddGuest() {
      return isTeacher(resource.data.centerId)
        && resource.data.teacherId == request.auth.uid
        && resource.data.status == 'inProgress'
        && request.resource.data.status == 'inProgress'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestStudentIds', 'updatedAt'])
        && request.resource.data.guestStudentIds.size() == resource.data.get('guestStudentIds', []).size() + 1
        && request.resource.data.guestStudentIds.hasAll(resource.data.get('guestStudentIds', []))
        && directoryEntry(request.resource.data.guestStudentIds[request.resource.data.guestStudentIds.size() - 1]).centerId == resource.data.centerId
        && directoryEntry(request.resource.data.guestStudentIds[request.resource.data.guestStudentIds.size() - 1]).active == true;
    }

    function directoryEntry(studentId) {
      return get(/databases/$(database)/documents/student_directory/$(studentId)).data;
    }

    function sessionDoc(sessionId) {
      return get(/databases/$(database)/documents/schedules/$(sessionId)).data;
    }

    // A student-role account whose profile says it currently attends [circleId].
    function studentInCircle(centerId, circleId) {
      return hasRole(centerId, 'student')
        && studentOf(profile().studentId).currentCircleId == circleId;
    }

    // ---------- users (backend-written only) ----------
    match /users/{uid} {
      // A user may always read their own profile so the app can show
      // pending / suspended screens. Directors read profiles in their center.
      allow read: if signedIn()
        && (request.auth.uid == uid || isDirector(resource.data.centerId));
      allow write: if false;
    }

    match /centers/{centerId} {
      allow read: if isActiveMember(centerId);
      allow write: if false;
    }

    // ---------- students ----------
    match /students/{studentId} {
      allow read: if isDirector(resource.data.centerId)
        || (isTeacher(resource.data.centerId)
            && request.auth.uid in resource.data.assignedTeacherIds)
        || ownsStudent(resource.data.centerId, studentId);

      // New profiles are always accountless; logins are attached later by the
      // enableStudentAccess Cloud Function.
      allow create: if isDirector(request.resource.data.centerId)
        && request.resource.data.accountMode == 'none'
        && (!('authUserId' in request.resource.data)
            || request.resource.data.authUserId == null);

      // Directors edit profiles but can never touch the account link/mode or
      // move a student to another center.
      allow update: if isDirector(resource.data.centerId)
        && unchanged(['centerId', 'authUserId', 'accountMode']);

      allow delete: if false; // archive instead; history is preserved
    }

    // ---------- teachers ----------
    match /teachers/{teacherId} {
      allow read: if isDirector(resource.data.centerId)
        || (isTeacher(resource.data.centerId) && request.auth.uid == teacherId);
      // Teachers are created, suspended and reactivated only by the
      // createTeacher / setTeacherSuspended Cloud Functions, which also manage
      // the login. A client-made teacher document would have no account and
      // would break the "document id == auth uid" convention.
      allow create: if false;
      allow update: if isDirector(resource.data.centerId)
        && unchanged(['centerId', 'userId', 'status']);
      allow delete: if false;
    }

    // ---------- circles ----------
    match /circles/{circleId} {
      allow read: if isDirector(resource.data.centerId)
        || (isTeacher(resource.data.centerId)
            && resource.data.assignedTeacherId == request.auth.uid)
        || studentInCircle(resource.data.centerId, circleId);
      // activeCount (seats taken) can never exceed maxCapacity, however the
      // write is made, so a capacity race or a capacity cut below the current
      // number of students is refused by the backend itself.
      allow create: if isDirector(request.resource.data.centerId)
        && request.resource.data.get('activeCount', 0) == 0;
      allow update: if isDirector(resource.data.centerId) && unchanged(['centerId'])
        && request.resource.data.get('activeCount', 0) >= 0
        && request.resource.data.get('activeCount', 0) <= request.resource.data.get('maxCapacity', 0);
      allow delete: if false;
    }

    // ---------- enrollments ----------
    match /enrollments/{enrollmentId} {
      allow read: if isDirector(resource.data.centerId)
        || (isTeacher(resource.data.centerId)
            && resource.data.teacherId == request.auth.uid)
        || ownsStudent(resource.data.centerId, resource.data.studentId);
      allow create: if isDirector(request.resource.data.centerId);
      allow update: if isDirector(resource.data.centerId)
        && unchanged(['centerId', 'studentId']);
      allow delete: if false;
    }

    // ---------- schedules ----------
    match /schedules/{scheduleId} {
      allow read: if isDirector(resource.data.centerId)
        || (isTeacher(resource.data.centerId)
            && resource.data.teacherId == request.auth.uid)
        || studentInCircle(resource.data.centerId, resource.data.circleId);
      allow create: if isDirector(request.resource.data.centerId);
      allow update: if (isDirector(resource.data.centerId) && unchanged(['centerId']))
        || teacherMaySetSessionStatus()
        || teacherMayAddGuest();
      allow delete: if false;
    }

    // ---------- attendance ----------
    // Document id is "<sessionId>_<studentId>": one record per student per
    // session, and retries cannot create duplicates.
    match /attendance/{attendanceId} {
      allow read: if isDirector(resource.data.centerId)
        || (isTeacher(resource.data.centerId)
            && resource.data.recordedBy == request.auth.uid)
        || ownsStudent(resource.data.centerId, resource.data.studentId);

      // A teacher records attendance only for a student assigned to them, as
      // themselves, with no correction metadata.
      allow create: if isTeacher(request.resource.data.centerId)
        && request.resource.data.recordedBy == request.auth.uid
        && attendanceId == request.resource.data.sessionId + '_' + request.resource.data.studentId
        && request.resource.data.status in ['present', 'absent', 'late', 'excused']
        && !('correctionMetadata' in request.resource.data)
        && sessionDoc(request.resource.data.sessionId).teacherId == request.auth.uid
        && sessionDoc(request.resource.data.sessionId).centerId == request.resource.data.centerId
        && sessionDoc(request.resource.data.sessionId).status == 'inProgress'
        && mayTeachStudent(request.resource.data.sessionId, request.resource.data.studentId, request.resource.data.centerId);

      // Only a director may change a recorded value, and only as an explicit,
      // attributed correction. Teachers and students cannot alter records.
      allow update: if (isDirector(resource.data.centerId)
        && unchanged(['centerId', 'sessionId', 'studentId', 'recordedBy'])
        && request.resource.data.status in ['present', 'absent', 'late', 'excused']
        && request.resource.data.correctionMetadata.correctedBy == request.auth.uid)
        || teacherMayFixOwnRecord();

      allow delete: if false;
    }

    // ---------- audit trail (append-only) ----------
    match /audit_logs/{auditId} {
      allow read: if isDirector(resource.data.centerId);
      allow create: if isDirector(request.resource.data.centerId)
        && request.resource.data.actorUserId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- memorization assessments ----------
    // Everything in a memorization record may be shown to the student it is
    // about. The teacher's private note is a separate document (below), because
    // rules cannot hide individual fields of a document.
    match /memorization_records/{recordId} {
      allow read: if isDirector(resource.data.centerId)
        || (isTeacher(resource.data.centerId)
            && (resource.data.teacherId == request.auth.uid
                // a student's own teacher sees every wird of that student, also
                // those heard by a visiting teacher
                || request.auth.uid in studentOf(resource.data.studentId).assignedTeacherIds))
        || ownsStudent(resource.data.centerId, resource.data.studentId);

      // Recorded by the session's teacher, for one of their students, while the
      // session is in progress, with a valid surah / ayah range.
      allow create: if isTeacher(request.resource.data.centerId)
        && request.resource.data.teacherId == request.auth.uid
        && !('privateTeacherNote' in request.resource.data)
        && request.resource.data.sessionId is string
        && sessionDoc(request.resource.data.sessionId).teacherId == request.auth.uid
        && sessionDoc(request.resource.data.sessionId).centerId == request.resource.data.centerId
        && sessionDoc(request.resource.data.sessionId).status == 'inProgress'
        && mayTeachStudent(request.resource.data.sessionId, request.resource.data.studentId, request.resource.data.centerId)
        && request.resource.data.assessmentType in ['newMemorization', 'recentRevision', 'longTermRevision', 'generalRecitation', 'newAssignment']
        && (request.resource.data.assessmentType == 'newAssignment' || validGrade(request.resource.data))
        && request.resource.data.surah is int
        && request.resource.data.surah >= 1 && request.resource.data.surah <= 114
        && request.resource.data.startAyah is int && request.resource.data.startAyah >= 1
        && request.resource.data.endAyah is int
        && request.resource.data.endAyah >= request.resource.data.startAyah;

      // The author may amend it only while the same session is in progress.
      allow update: if isTeacher(resource.data.centerId)
        && resource.data.teacherId == request.auth.uid
        && sessionDoc(resource.data.sessionId).status == 'inProgress'
        && !('privateTeacherNote' in request.resource.data)
        && unchanged(['centerId', 'studentId', 'teacherId', 'sessionId', 'circleId', 'assessedAt', 'createdAt', 'assessmentType', 'visitId'])
        && (resource.data.assessmentType == 'newAssignment' || validGrade(request.resource.data))
        && request.resource.data.surah is int
        && request.resource.data.surah >= 1 && request.resource.data.surah <= 114
        && request.resource.data.startAyah >= 1
        && request.resource.data.endAyah >= request.resource.data.startAyah;

      allow delete: if false;
    }

    // The teacher's private note about an assessment. Same id as the
    // assessment. Never readable by students.
    match /private_teacher_notes/{noteId} {
      allow read: if isDirector(resource.data.centerId)
        || (isTeacher(resource.data.centerId)
            && resource.data.teacherId == request.auth.uid);
      allow create: if isTeacher(request.resource.data.centerId)
        && request.resource.data.teacherId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/memorization_records/$(noteId))
        && getAfter(/databases/$(database)/documents/memorization_records/$(noteId)).data.teacherId == request.auth.uid
        && getAfter(/databases/$(database)/documents/memorization_records/$(noteId)).data.studentId == request.resource.data.studentId;
      allow update: if isTeacher(resource.data.centerId)
        && resource.data.teacherId == request.auth.uid
        && unchanged(['centerId', 'studentId', 'teacherId']);
      allow delete: if false;
    }

    // ---------- learning plans & tasks ----------
    // One plan document per (student, teacher) -- "plan_<studentId>_<teacherId>"
    // -- groups the tasks a teacher gives a student, so a change of teacher
    // never needs to edit another teacher's plan.
    function studentOf(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId)).data;
    }

    function validAyahRange(d) {
      return d.surah is int && d.surah >= 1 && d.surah <= 114
        && d.startAyah is int && d.startAyah >= 1
        && d.endAyah is int && d.endAyah >= d.startAyah;
    }

    match /learning_plans/{planId} {
      allow read: if isDirector(resource.data.centerId)
        || (isTeacher(resource.data.centerId)
            && resource.data.responsibleTeacherId == request.auth.uid)
        || ownsStudent(resource.data.centerId, resource.data.studentId);
      allow create: if isTeacher(request.resource.data.centerId)
        && request.resource.data.responsibleTeacherId == request.auth.uid
        && planId == 'plan_' + request.resource.data.studentId + '_' + request.auth.uid
        && request.auth.uid in studentOf(request.resource.data.studentId).assignedTeacherIds
        && studentOf(request.resource.data.studentId).centerId == request.resource.data.centerId;
      allow update: if isTeacher(resource.data.centerId)
        && resource.data.responsibleTeacherId == request.auth.uid
        && unchanged(['centerId', 'studentId', 'responsibleTeacherId']);
      allow delete: if false;
    }

    function openTask(status) {
      return status in ['upcoming', 'inProgress', 'practiceReported', 'submittedForReview', 'needsReview'];
    }

    // Staff-only notes about a student. Kept out of the student document
    // because a student may read that document and rules cannot hide fields.
    match /student_admin_notes/{studentId} {
      allow read: if isDirector(resource.data.centerId);
      allow create: if isDirector(request.resource.data.centerId)
        && studentId == request.resource.data.studentId
        && studentOf(studentId).centerId == request.resource.data.centerId;
      allow update: if isDirector(resource.data.centerId)
        && unchanged(['centerId', 'studentId']);
      allow delete: if false;
    }

    // The student moves their own task along, claims practice, and nothing
    // else. Completing, cancelling or marking it "needs review" is the
    // teacher's alone, and a claim is stored as a claim (selfReportedPractice).
    function studentMayReportProgress() {
      return ownsStudent(resource.data.centerId, resource.data.studentId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'selfReportedPractice', 'updatedAt'])
        && (
          (resource.data.status == 'upcoming'
            && request.resource.data.status in ['inProgress', 'practiceReported'])
          || (resource.data.status == 'inProgress'
            && request.resource.data.status == 'practiceReported')
          || (resource.data.status == 'practiceReported'
            && request.resource.data.status == 'submittedForReview')
          || (resource.data.status == 'needsReview'
            && request.resource.data.status in ['inProgress', 'practiceReported'])
        )
        && (request.resource.data.status != 'practiceReported'
            || (request.resource.data.get('selfReportedPractice', null) != null
                && request.resource.data.selfReportedPractice.reportedAt != null))
        && (request.resource.data.status in ['practiceReported'] 
            || !changed(['selfReportedPractice']));
    }

    match /learning_tasks/{taskId} {
      allow read: if isDirector(resource.data.centerId)
        || (isTeacher(resource.data.centerId)
            && resource.data.teacherId == request.auth.uid)
        || ownsStudent(resource.data.centerId, resource.data.studentId);

      // Assigned by a teacher to one of their students: always starts as
      // 'upcoming' with no practice claim and no verification.
      allow create: if isTeacher(request.resource.data.centerId)
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.status == 'upcoming'
        && request.resource.data.get('selfReportedPractice', null) == null
        && request.resource.data.get('teacherVerification', null) == null
        && request.resource.data.planId == 'plan_' + request.resource.data.studentId + '_' + request.auth.uid
        && request.auth.uid in studentOf(request.resource.data.studentId).assignedTeacherIds
        && studentOf(request.resource.data.studentId).centerId == request.resource.data.centerId
        && validAyahRange(request.resource.data)
        && request.resource.data.dueDate >= request.resource.data.assignedDate;

      allow update: if isTeacher(resource.data.centerId)
        && resource.data.teacherId == request.auth.uid
        && (
          // edit the assignment before the student has started
          (resource.data.status == 'upcoming'
            && request.resource.data.status == 'upcoming'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['teacherInstructions', 'dueDate', 'priority', 'updatedAt']))
          // official verification: only the teacher can complete a task
          || (openTask(resource.data.status)
            && request.resource.data.status in ['completed', 'needsReview']
            && request.resource.data.status != resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'teacherVerification', 'completionMetadata', 'updatedAt'])
            && request.resource.data.teacherVerification.verifiedBy == request.auth.uid
            && ((request.resource.data.status == 'completed'
                  && request.resource.data.teacherVerification.result == 'passed')
                || (request.resource.data.status == 'needsReview'
                  && request.resource.data.teacherVerification.result == 'needs_improvement')))
          // cancellation, with its reason kept in completionMetadata
          || (openTask(resource.data.status)
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'completionMetadata', 'updatedAt'])
            && request.resource.data.completionMetadata.reason is string)
        )
        || studentMayReportProgress();
      allow delete: if false;
    }

    // ---------- finance (director only) ----------
    // Subscriptions, payments, expenses and wages are visible to the director
    // alone; a teacher may read only their OWN wage record. Money is a whole
    // number of minor units. Nothing is deleted: mistakes are voided with a
    // reason, so the books keep their history.
    function money(v) { return v is int && v >= 0 && v <= 100000000000; }

    match /student_fees/{studentId} {
      allow read: if isDirector(resource.data.centerId);
      allow create: if isDirector(request.resource.data.centerId)
        && studentId == request.resource.data.studentId
        && money(request.resource.data.monthlyFee)
        && getAfter(/databases/$(database)/documents/students/$(studentId)).data.centerId == request.resource.data.centerId;
      allow update: if isDirector(resource.data.centerId)
        && unchanged(['centerId', 'studentId']) && money(request.resource.data.monthlyFee);
      allow delete: if false;
    }

    match /subscriptions/{subId} {
      allow read: if isDirector(resource.data.centerId);
      allow create: if isDirector(request.resource.data.centerId)
        && subId == request.resource.data.studentId + '_' + request.resource.data.month
        && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && money(request.resource.data.amountDue)
        && request.resource.data.amountPaid == 0
        && getAfter(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.centerId == request.resource.data.centerId;
      allow update: if isDirector(resource.data.centerId)
        && unchanged(['centerId', 'studentId', 'month'])
        && money(request.resource.data.amountDue) && money(request.resource.data.amountPaid);
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isDirector(resource.data.centerId);
      allow create: if isDirector(request.resource.data.centerId)
        && request.resource.data.amount is int && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000000000
        && request.resource.data.voided == false
        && request.resource.data.receivedBy == request.auth.uid
        && request.resource.data.method in ['cash', 'transfer', 'other']
        && getAfter(/databases/$(database)/documents/subscriptions/$(request.resource.data.subscriptionId)).data.centerId == request.resource.data.centerId;
      // Only voiding is allowed: the amount, the subscription and the date never change.
      allow update: if isDirector(resource.data.centerId)
        && resource.data.voided == false && request.resource.data.voided == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided', 'voidReason', 'voidedBy', 'voidedAt'])
        && request.resource.data.voidedBy == request.auth.uid;
      allow delete: if false;
    }

    match /expenses/{expenseId} {
      allow read: if isDirector(resource.data.centerId);
      allow create: if isDirector(request.resource.data.centerId)
        && request.resource.data.amount is int && request.resource.data.amount > 0
        && request.resource.data.amount <= 100000000000
        && request.resource.data.voided == false
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.category in ['rent', 'utilities', 'supplies', 'maintenance', 'events', 'other'];
      allow update: if isDirector(resource.data.centerId)
        && resource.data.voided == false && request.resource.data.voided == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided', 'voidReason', 'voidedBy', 'voidedAt'])
        && request.resource.data.voidedBy == request.auth.uid;
      allow delete: if false;
    }

    match /wage_rates/{teacherId} {
      allow read: if isDirector(resource.data.centerId);
      allow create: if isDirector(request.resource.data.centerId)
        && teacherId == request.resource.data.teacherId && money(request.resource.data.monthlyAmount)
        && getAfter(/databases/$(database)/documents/teachers/$(teacherId)).data.centerId == request.resource.data.centerId;
      allow update: if isDirector(resource.data.centerId)
        && unchanged(['centerId', 'teacherId']) && money(request.resource.data.monthlyAmount);
      allow delete: if false;
    }

    match /wages/{wageId} {
      allow read: if isDirector(resource.data.centerId)
        || (isTeacher(resource.data.centerId) && resource.data.teacherId == request.auth.uid);
      allow create: if isDirector(request.resource.data.centerId)
        && wageId == request.resource.data.teacherId + '_' + request.resource.data.month
        && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.status == 'due'
        && request.resource.data.amount is int && request.resource.data.amount >= 0
        && getAfter(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.centerId == request.resource.data.centerId;
      // Adjust the amount while due; mark paid once (then it is frozen).
      allow update: if isDirector(resource.data.centerId)
        && resource.data.status == 'due'
        && unchanged(['centerId', 'teacherId', 'month'])
        && request.resource.data.status in ['due', 'paid']
        && request.resource.data.amount is int && request.resource.data.amount >= 0
        && (request.resource.data.status == 'due' || request.resource.data.paidBy == request.auth.uid);
      allow delete: if false;
    }

    // ---------- student directory ----------
    // A minimal public card per student (name only) so a teacher can find a
    // student of another circle to hear as a visiting student. The student
    // document itself stays private to the student's own teachers.
    match /student_directory/{studentId} {
      allow read: if isDirector(resource.data.centerId) || isTeacher(resource.data.centerId);
      allow create: if isDirector(request.resource.data.centerId)
        && getAfter(/databases/$(database)/documents/students/$(studentId)).data.centerId == request.resource.data.centerId;
      allow update: if isDirector(resource.data.centerId) && unchanged(['centerId']);
      allow delete: if false;
    }

    // ---------- notifications & announcements ----------
    // A notification is addressed to ONE user and only that user can read it.
    // Titles/messages never carry sensitive student detail. It is created by a
    // director (announcements, alerts) or, for task events only, by the student's
    // own teacher, and always for a real login of the same center.
    function userInCenter(uid, centerId) {
      return get(/databases/$(database)/documents/users/$(uid)).data.centerId == centerId
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'active';
    }

    match /notifications/{notificationId} {
      allow read: if isActiveMember(resource.data.centerId)
        && resource.data.recipientUserId == request.auth.uid;

      allow create: if request.resource.data.read == false
        && (
          (isDirector(request.resource.data.centerId)
            && request.resource.data.type in ['center_announcement', 'admin_alert', 'schedule_change']
            && userInCenter(request.resource.data.recipientUserId, request.resource.data.centerId))
          || (isTeacher(request.resource.data.centerId)
            && request.resource.data.type in ['new_assignment', 'teacher_feedback']
            && request.resource.data.relatedEntityType == 'student'
            && request.auth.uid in studentOf(request.resource.data.relatedEntityId).assignedTeacherIds
            && studentOf(request.resource.data.relatedEntityId).authUserId == request.resource.data.recipientUserId
            && studentOf(request.resource.data.relatedEntityId).centerId == request.resource.data.centerId)
        );

      // The recipient may only mark it read.
      allow update: if isActiveMember(resource.data.centerId)
        && resource.data.recipientUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true;

      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if isDirector(resource.data.centerId);
      allow create: if isDirector(request.resource.data.centerId)
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isDirector(resource.data.centerId)
        && unchanged(['centerId', 'authorId']);
      allow delete: if false;
    }

    // announcements aside,
    // announcements, ... are intentionally NOT opened yet. They fall through
    // to default deny until their feature is implemented and tested.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
