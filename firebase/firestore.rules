rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check user is active member of center
    function isActiveCenterMember(centerId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.centerId == centerId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isDirector(centerId) {
      return isActiveCenterMember(centerId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director';
    }

    function isTeacher(centerId) {
      return isActiveCenterMember(centerId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function isStudent(centerId) {
      return isActiveCenterMember(centerId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    // Students may read their own profile only
    match /students/{studentId} {
      allow read: if request.auth != null
        && (resource.data.authUserId == request.auth.uid || isDirector(resource.data.centerId));
      allow create: if isDirector(resource.data.centerId);
      allow update: if isDirector(resource.data.centerId);
      allow delete: if false; // preserve history; archive instead
    }

    // Attendance: one record per student per session; teachers record, directors correct
    match /attendance/{attendanceId} {
      allow read: if isActiveCenterMember(resource.data.centerId);
      allow create: if isTeacher(resource.data.centerId)
        && request.resource.data.recordedBy == request.auth.uid;
      allow update: if isDirector(resource.data.centerId)
        || (isTeacher(resource.data.centerId) && request.resource.data.recordedBy == request.auth.uid);
      allow delete: if false;
    }

    // Default: deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
